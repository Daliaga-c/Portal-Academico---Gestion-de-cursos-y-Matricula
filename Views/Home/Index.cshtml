@model IEnumerable<PortalAcademico.Web.Models.Entities.Curso>

@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="hero-section p-5 mb-5 shadow-sm text-center">
    <h1 class="display-4 fw-bold text-dark mb-3">Descubre tu próximo curso</h1>
    <p class="lead text-muted col-md-8 mx-auto">
        Explora nuestra oferta académica. Diseña tu futuro hoy mismo con los mejores programas de formación, pensados para llevar tus habilidades al siguiente nivel.
    </p>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var curso in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card course-card shadow-sm h-100">
                    <div class="card-top-gradient"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-upc-scan me-1"></i> @curso.Codigo
                            </span>
                            <span class="badge @(curso.Activo ? "bg-success" : "bg-danger") bg-opacity-75 rounded-pill px-3 py-2">
                                @(curso.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        
                        <h4 class="card-title fw-bold mb-4 text-dark">@curso.Nombre</h4>
                        
                        <div class="d-flex flex-column gap-3 text-secondary mb-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-journal-bookmark"></i></div>
                                <span><strong class="text-dark">@curso.Creditos</strong> Créditos académicos</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-people"></i></div>
                                <span><strong class="text-dark">@curso.CupoMaximo</strong> Estudiantes máx.</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-clock"></i></div>
                                <span>@curso.HorarioInicio.ToString(@"hh\:mm") - @curso.HorarioFin.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer bg-transparent border-0 p-4 pt-0 mt-auto">
                        <button class="btn btn-outline-primary w-100 rounded-pill fw-semibold py-2">
                            Ver Detalles
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center w-100" role="alert">
            No se encontraron cursos en la base de datos.
        </div>
    }
</div>