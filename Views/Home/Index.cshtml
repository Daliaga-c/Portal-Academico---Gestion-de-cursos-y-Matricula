@model IEnumerable<PortalAcademico.Web.Models.Entities.Curso>

@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="hero-section p-5 mb-5 shadow-sm text-center">
    <h1 class="display-4 fw-bold text-dark mb-3">Descubre tu próximo curso</h1>
    <p class="lead text-muted col-md-8 mx-auto">
        Explora nuestra oferta académica. Diseña tu futuro hoy mismo con los mejores programas de formación, pensados para llevar tus habilidades al siguiente nivel.
    </p>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-5">
    <form asp-controller="Cursos" asp-action="Catalogo" method="get" class="card shadow-sm border-0 p-4 bg-light">
        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-funnel me-2"></i>Filtros de búsqueda</h5>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="buscarNombre" class="form-label fw-semibold text-secondary">Nombre del curso</label>
                <input type="text" class="form-control" id="buscarNombre" name="buscarNombre" placeholder="Ej. Matemáticas" value="@ViewData["BuscarNombre"]">
            </div>
            <div class="col-md-2">
                <label for="minCreditos" class="form-label fw-semibold text-secondary">Mín. Créditos</label>
                <input type="number" class="form-control" id="minCreditos" name="minCreditos" min="1" placeholder="Ej. 2" value="@ViewData["MinCreditos"]">
            </div>
            <div class="col-md-2">
                <label for="maxCreditos" class="form-label fw-semibold text-secondary">Máx. Créditos</label>
                <input type="number" class="form-control" id="maxCreditos" name="maxCreditos" min="1" placeholder="Ej. 5" value="@ViewData["MaxCreditos"]">
            </div>
            <div class="col-md-3">
                <label for="horarioBusqueda" class="form-label fw-semibold text-secondary">Horario</label>
                <input type="time" class="form-control" id="horarioBusqueda" name="horarioBusqueda" value="@ViewData["HorarioBusqueda"]">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
            </div>
        </div>
    </form>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var curso in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card course-card shadow-sm h-100">
                    <div class="card-top-gradient"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-upc-scan me-1"></i> @curso.Codigo
                            </span>
                            <span class="badge @(curso.Activo ? "bg-success" : "bg-danger") bg-opacity-75 rounded-pill px-3 py-2">
                                @(curso.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        
                        <h4 class="card-title fw-bold mb-4 text-dark">@curso.Nombre</h4>
                        
                        <div class="d-flex flex-column gap-3 text-secondary mb-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-journal-bookmark"></i></div>
                                <span><strong class="text-dark">@curso.Creditos</strong> Créditos académicos</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-people"></i></div>
                                <span><strong class="text-dark">@curso.CupoMaximo</strong> Estudiantes máx.</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-wrapper"><i class="bi bi-clock"></i></div>
                                <span>@curso.HorarioInicio.ToString(@"hh\:mm") - @curso.HorarioFin.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer bg-transparent border-0 p-4 pt-0 mt-auto d-flex flex-column gap-2">
                        <a asp-controller="Cursos" asp-action="Detalles" asp-route-id="@curso.Id" class="btn btn-outline-primary w-100 rounded-pill fw-semibold py-2">
                            Ver Detalles
                        </a>
                        <form asp-controller="Cursos" asp-action="Inscribirse" method="post" class="m-0">
                            <input type="hidden" name="id" value="@curso.Id" />
                            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold py-2">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Inscribirse
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center w-100" role="alert">
            No se encontraron cursos en la base de datos.
        </div>
    }
</div>